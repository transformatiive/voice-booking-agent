{
  "name": "atende-voice-agents",
  "version": "0.1.0",
  "private": true,
  "description": "Atende — voice booking agent SaaS for Portuguese SMEs (barbearias, salões, clínicas). PT-first landing, thin backoffice, Cal.com scheduling, Telnyx/Zadarma numbers, Stripe subscriptions.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "chrono-node": "^2.7.7",
    "express": "^4.19.2",
    "stripe": "^17.5.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.9.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "eslint": "^9.9.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^2.0.0"
  }
}
