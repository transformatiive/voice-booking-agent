# ---- Core ----
PORT=3000
# Public base URL of the deployment (used for Stripe redirects, webhooks, etc.)
PUBLIC_BASE_URL=http://localhost:3000
# ---- Persistence ----
# Preferred: Postgres (e.g. Railway Postgres). When DATABASE_URL is set, the app
# persists to Postgres; otherwise it falls back to a JSON file in DATA_DIR.
DATABASE_URL=
# Set to "true" to force SSL (needed for Railway's PUBLIC proxy URL; the internal
# *.railway.internal URL does not need it).
DATABASE_SSL=
# JSON-file fallback location (used only when DATABASE_URL is unset). Mount a
# Railway volume here if you deploy without Postgres.
DATA_DIR=./data

# ---- Scheduling: Cal.com (scheduling brain; Google Calendar sync is set up inside Cal.com) ----
CAL_API_KEY=
CAL_API_BASE=https://api.cal.com/v2

# ---- Billing: Stripe subscriptions (plan price already includes the DID cost) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ids for each plan + optional metered overage price:
STRIPE_PRICE_BASE=
STRIPE_PRICE_PRO=
STRIPE_PRICE_STUDIO=
STRIPE_PRICE_OVERAGE=

# ---- Telephony: number provider (Telnyx primary, Zadarma fallback) ----
# TELEPHONY_PROVIDER=telnyx|zadarma|mock  (auto-detected from keys when unset)
TELEPHONY_PROVIDER=
TELNYX_API_KEY=
TELNYX_CONNECTION_ID=
ZADARMA_KEY=
ZADARMA_SECRET=
# Fallback warm-transfer destination when a resource has no mobile set:
DEFAULT_TRANSFER_NUMBER=

# ---- Voice orchestrator (Grok Live 2 / Retell / Vapi) ----
# Shared secret required on /voice/functions/:slug when set:
VOICE_FUNCTION_SECRET=
